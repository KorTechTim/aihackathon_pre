    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.11.2",
    "openai": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  }
}
